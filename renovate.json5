// Renovate: https://docs.renovatebot.com. JSON5, so comments are allowed.
// The template repository and every generated project share this file, so
// it also matches `.github-project/`, where the template keeps the project's
// workflows. In a project that directory doesn't exist and those patterns
// match nothing.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "14 days",
  // Added to the default `.github/workflows/`; only matters in the template.
  "github-actions": {
    "managerFilePatterns": ["/(^|/)\\.github-project/workflows/[^/]+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "One PR for all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "One PR for the devcontainer tool versions and base image",
      "matchFileNames": [".devcontainer/**"],
      "groupName": "devcontainer"
    },
    {
      "description": "Stable Rust toolchain bumps",
      "matchFileNames": ["rust-toolchain.toml"],
      "groupName": "Rust toolchain",
      "minimumReleaseAge": "0 days"
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions annotated with `# renovate:` comments",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/tools\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[a-z0-9-]+ = \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Pinned stable toolchain",
      "customType": "regex",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "release-plz, installed by the release workflow",
      "customType": "regex",
      // `.github-project/` is the template's copy of the project's workflows.
      "managerFilePatterns": ["/^\\.github(-project)?/workflows/release-plz\\.yml$/"],
      "matchStrings": ["release-plz@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "release-plz",
      "datasourceTemplate": "crate"
    }
  ]
}
